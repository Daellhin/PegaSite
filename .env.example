# Get Firebase API keys from https://console.firebase.google.com/project/pega-site/settings/general
VITE_APIKEY="long-key-string"
VITE_AUTHDOMAIN="something.firebaseapp.com"
VITE_PROJECTID="something"
VITE_STORAGEBUCKET="something.appspot.com"
VITE_MESSAGINGSENDERID="some-number"
VITE_APPID="long-key-string"
VITE_MEASUREMENTID="key-string"

# Get Geoapify API key from https://myprojects.geoapify.com/api/0C4jUeVhRBormH2L1Kio/keys
VITE_GEOAPIFY_APIKEY="long-key-string"

# Debugging
VITE_USEMOCKING="false"